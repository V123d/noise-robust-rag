# ============================================================
# Noise-Robust RAG 环境变量配置
# ============================================================
# 复制此文件为 .env，填写实际值后使用。
# .env 文件不会被提交到 Git（已在 .gitignore 中排除）。

# -------------------- DashScope API --------------------
# 阿里云 DashScope API Key（用于调用通义千问 qwen-plus）
# 申请地址: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your-api-key-here

# -------------------- HuggingFace --------------------
# 设置 HF 镜像站点（国内加速访问）
HF_ENDPOINT=https://hf-mirror.com

# HuggingFace 模型缓存目录（相对项目根目录的 ./hf_models/）
HF_HOME=./hf_models

# -------------------- 实验配置 --------------------
# 随机种子（保证实验可复现）
RANDOM_SEED=42

# 知识库路径（可修改为其他品类 CSV）
CORPUS_PATH=./data/processed/tablet_corpus.csv

# 结果输出目录
RESULTS_DIR=./results
